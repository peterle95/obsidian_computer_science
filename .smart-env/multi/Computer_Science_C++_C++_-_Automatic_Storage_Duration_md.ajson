0.01007579,0.04076738,-0.02734385,0.08661027,-0.03660444,0.00061279,0.02966672,0.1803979,0.01410567,0.02901659,0.04040179,0.00774666,0.01949235,0.12842591,0.04845095,-0.02699795,-0.03412723,0.11099544,0.05862455,-0.04251631,0.06702939,-0.05567669,0.02723732,0.02149345,0.00696711,0.01701295,-0.01704503,0.02526128,0.02774054,0.07936275,-0.03081768,0.03716515,-0.08118184,-0.03772022,-0.06114125,-0.01006095,0.0060826,0.00261268,-0.00130776,0.02032944,0.10065764,0.03028545,-0.03600935,-0.03021561,-0.04133938,0.00124577,-0.03764381,0.07943472,0.03145364,0.02331014],"last_embed":{"hash":"60nyit","tokens":445}}},"last_read":{"hash":"60nyit","at":1762678887093},"class_name":"SmartSource","last_import":{"mtime":1762678761744,"size":20668,"at":1762678872084,"hash":"60nyit"},"blocks":{"#---frontmatter---":[1,16],"#":[17,426],"#**Purpose/Why**:":[427,439],"#**Purpose/Why**:#{1}":[429,435],"#**Purpose/Why**:#{2}":[436,436],"#**Purpose/Why**:#{3}":[437,437],"#**Purpose/Why**:#{4}":[438,439],"#**Core Explanation:**":[440,444],"#**Core Explanation:**#{1}":[442,444],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.":[445,458],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{1}":[447,448],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{2}":[449,449],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{3}":[450,450],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{4}":[451,451],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{5}":[452,452],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{6}":[453,454],"#FF5582A6;\"> type of storage duration in C++ where an object's lifetime is tied to its scope</mark>. Variables with automatic storage duration are typically allocated on the program's call stack.#{7}":[455,458],"#BBFABBA6;\"> a new \"stack frame\" is pushed onto the call stack.</mark> This stack frame contains <mark style=\"background:":[459,460],"#BBFABBA6;\">space for the function's parameters, its local automatic variables, and other administrative information. As the function executes, its local automatic variables are created within this stack frame.</mark>":[461,464],"#BBFABBA6;\">space for the function's parameters, its local automatic variables, and other administrative information. As the function executes, its local automatic variables are created within this stack frame.</mark>#{1}":[463,464],"#FFB8EBA6;\">function finishes execution</mark> (either by returning or throwing an exception),<mark style=\"background:":[465,466],"#FFB8EBA6;\"> its stack frame is popped off the call stack. This action automatically deallocates all the memory associated with the function's parameters and local automatic variables.</mark>":[467,470],"#FFB8EBA6;\"> its stack frame is popped off the call stack. This action automatically deallocates all the memory associated with the function's parameters and local automatic variables.</mark>#{1}":[469,470],"#D2B3FFA6;\">when used as a storage class specifier (prior to C++11), explicitly declared a variable with automatic storage duration</mark>. However, its use for this purpose is now largely superseded by its role in type deduction (since C++11). Still, understanding that most local variables implicitly have `auto` storage duration is fundamental.":[471,472],"#**Related Concepts:**":[473,487],"#**Related Concepts:**#{1}":[475,475],"#**Related Concepts:**#{2}":[476,477],"#**Related Concepts:**#{3}":[478,479],"#**Related Concepts:**#{4}":[480,481],"#**Related Concepts:**#{5}":[482,483],"#**Related Concepts:**#{6}":[484,485],"#**Related Concepts:**#{7}":[486,487],"#**Examples:**":[488,552],"#**Examples:**#{1}":[490,552],"#**Flashcards:**":[553,560],"#**Flashcards:**#{1}":[555,560]},"outlinks":[{"title":"C++ - Auto Keyword","target":"C++ - Auto Keyword","line":469},{"title":"Call Stack","target":"Call Stack","line":478}],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["C++"],"review-date":"","last-reviewed":"2025-08-14","scheda":"done","cssclasses":null,"visit-count":4,"confidence-level":2,"consecutive-correct":3,"last-struggle-date":"2025-07-05"},"last_embed":{"hash":"60nyit","at":1762678887008},"key":"Computer Science/C++/C++ - Automatic Storage Duration.md","task_lines":[]},
