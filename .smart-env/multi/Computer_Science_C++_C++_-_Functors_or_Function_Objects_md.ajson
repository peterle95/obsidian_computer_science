private: // This member variable holds the state of the functor. int factor; public: // The constructor initializes the state of the functor. MultiplyBy(int x) : factor(x) {} // Overloading the function call operator ''. // This is what makes the object callable like a function. int operator(int other) const { return factor * other; } }; int main { // Create an instance of the MultiplyBy functor. // This functor will multiply any number by 10. MultiplyBy multiplyByTen(10); // \"Call\" the functor object as if it were a function. int result = multiplyByTen(5); // result will be 50 std::cout << \"Result: \" << result << std::endl; // Functors are commonly used with STL algorithms like std::transform. std::vector<int> in = {1, 2, 3, 4, 5}; std::vector<int> out(in.size); // Use a temporary functor object to multiply each element in the 'in' vector by 2 // and store the result in the 'out' vector. std::transform(in.begin, in.end, out.begin, MultiplyBy(2)); // Print the contents of the 'out' vector. for (int i : out) { std::cout << i << \" \"; // Output: 2 4 6 8 10 } std::cout << std::endl; return 0; }`","lines":[74,75],"size":1210,"outlinks":[],"class_name":"SmartBlock","last_embed":{"hash":"1wi5r04","at":1756493580501}},
