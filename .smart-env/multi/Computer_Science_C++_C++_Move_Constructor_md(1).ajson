7138175,-0.04485108,0.00192891,0.05909564,0.21646905,0.01709133,0.04502051,0.01395998,-0.00455084,-0.00777641,0.09566072,0.03236537,-0.01858552,-0.01899952,0.1230247,0.06207329,-0.02832681,0.0472856,-0.0367188,0.02070943,-0.00124818,-0.02420649,-0.01072141,0.02881524,0.0536014,0.05111669,0.08057957,-0.03321586,0.0147094,-0.07148143,-0.03053273,-0.03332576,-0.03317497,0.01196759,0.02018528,0.00672105,-0.01035685,0.09549944,0.01025499,-0.03505984,-0.0658446,-0.04644537,0.00592841,-0.03981689,0.08085325,0.03394869,0.03079178],"last_embed":{"hash":"1ac0q7i","tokens":448}}},"last_read":{"hash":"1ac0q7i","at":1758281591142},"class_name":"SmartSource","last_import":{"mtime":1757959175000,"size":22505,"at":1758281584358,"hash":"1ac0q7i"},"blocks":{"#---frontmatter---":[1,14],"#":[15,424],"#**Purpose/Why**:":[425,429],"#**Purpose/Why**:#{1}":[427,429],"#ADCCFFA6;\">Before C++11</mark> and the introduction of move semantics, <mark style=\"background:":[430,431],"#ADCCFFA6;\">initializing a new object from a temporary one that managed dynamic resources</mark>, like a `std::vector` or a custom class with a dynamically allocated array, <mark style=\"background:":[432,433],"#ADCCFFA6;\">would trigger the copy constructor.</mark>":[434,440],"#ADCCFFA6;\">would trigger the copy constructor.</mark>#{1}":[435,435],"#ADCCFFA6;\">would trigger the copy constructor.</mark>#{2}":[436,436],"#ADCCFFA6;\">would trigger the copy constructor.</mark>#{3}":[437,438],"#ADCCFFA6;\">would trigger the copy constructor.</mark>#{4}":[439,440],"#**Core Explanation:**":[441,454],"#**Core Explanation:**#{1}":[443,449],"#**Core Explanation:**#{2}":[450,450],"#**Core Explanation:**#{3}":[451,454],"#BBFABBA6;\">This is crucial: it ensures that when `other`'s destructor is called</mark> (as it's often a temporary object about to be destroyed), it doesn't attempt to deallocate the resources that have now been taken by the newly constructed object.":[455,459],"#BBFABBA6;\">This is crucial: it ensures that when `other`'s destructor is called</mark> (as it's often a temporary object about to be destroyed), it doesn't attempt to deallocate the resources that have now been taken by the newly constructed object.#{1}":[456,456],"#BBFABBA6;\">This is crucial: it ensures that when `other`'s destructor is called</mark> (as it's often a temporary object about to be destroyed), it doesn't attempt to deallocate the resources that have now been taken by the newly constructed object.#{2}":[457,457],"#BBFABBA6;\">This is crucial: it ensures that when `other`'s destructor is called</mark> (as it's often a temporary object about to be destroyed), it doesn't attempt to deallocate the resources that have now been taken by the newly constructed object.#{3}":[458,459],"#**Related Concepts:**":[460,469],"#**Related Concepts:**#{1}":[462,462],"#**Related Concepts:**#{2}":[463,463],"#**Related Concepts:**#{3}":[464,464],"#**Related Concepts:**#{4}":[465,465],"#**Related Concepts:**#{5}":[466,466],"#**Related Concepts:**#{6}":[467,467],"#**Related Concepts:**#{7}":[468,469],"#**Examples:**":[470,624],"#**Examples:**#{1}":[472,624],"#**Flashcards:**":[625,632],"#**Flashcards:**#{1}":[627,632]},"outlinks":[],"metadata":{"tags":["#to_learn"],"language":["C++"],"review-date":"2025-09-20","last-reviewed":"2025-09-02","scheda":"done","visit-count":1,"confidence-level":1,"consecutive-correct":0,"last-struggle-date":"2025-09-02"},"task_lines":[],"last_embed":{"hash":"1ac0q7i","at":1758281589196}},"smart_blocks:Computer Science/C++/C++ Move Constructor.md#": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05660181,-0.06159886,-0.01818254,-0.01285703,-0.01110302,0.04753618,-0.06642064,-0.01517393,0.03531183,0.00662564,0.00108299,-0.05233162,-0.00392968,0.02240582,-0.00550031,0.02641241,-0.061916,0.04478189,-0.04492671,0.00414317,0.03858778,-0.08327091,0.04659488,-0.08082502,-0.00747198,0.03018505,-0.05457311,-0.09709886,-0.00705804,-0.19962847,-0.06736882,-0.07666609,0.04656103,-0.00907161,