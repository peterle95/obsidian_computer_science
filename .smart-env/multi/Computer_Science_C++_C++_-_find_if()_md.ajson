.07750063,-0.04862516,0.02863341,0.05755802,0.22076498,-0.01925573,0.0207516,0.03427646,0.01547041,-0.04661992,0.11054017,0.03364001,-0.01253898,-0.05862467,0.11564979,0.03307896,-0.01909845,0.0709295,-0.05883832,0.03139836,0.00797851,-0.033327,0.0149173,0.01700532,0.02837703,0.03286847,0.08262565,-0.03210472,0.0284697,-0.04605484,-0.03333868,-0.04113003,-0.03704032,0.02188682,0.01443043,0.00622639,0.01226982,0.09680111,0.00763492,-0.0266865,-0.05588599,-0.06251422,-0.00617705,-0.04220013,0.09913246,0.0268454,0.02646033],"last_embed":{"hash":"ju6k4a","tokens":476}}},"last_read":{"hash":"ju6k4a","at":1756458490527},"class_name":"SmartSource","last_import":{"mtime":1756458467034,"size":19418,"at":1756458490027,"hash":"ju6k4a"},"blocks":{"#---frontmatter---":[1,13],"#":[15,367],"#**Purpose/Why**:":[368,372],"#**Purpose/Why**:#{1}":[369,372],"#**Core Explanation:**":[373,387],"#**Core Explanation:**#{1}":[374,378],"#**Core Explanation:**#{2}":[379,379],"#**Core Explanation:**#{3}":[380,380],"#**Core Explanation:**#{4}":[381,381],"#**Core Explanation:**#{5}":[382,382],"#**Core Explanation:**#{6}":[383,383],"#**Core Explanation:**#{7}":[384,385],"#**Core Explanation:**#{8}":[386,387],"#**Related Concepts:**":[388,398],"#**Related Concepts:**#{1}":[389,390],"#**Related Concepts:**#{2}":[391,391],"#**Related Concepts:**#{3}":[392,392],"#**Related Concepts:**#{4}":[393,393],"#**Related Concepts:**#{5}":[394,394],"#**Related Concepts:**#{6}":[395,395],"#**Related Concepts:**#{7}":[396,396],"#**Related Concepts:**#{8}":[397,398],"#**Examples:**":[399,513],"#**Examples:**#{1}":[400,400],"#**Examples:**#*Provide practical code examples that illustrate the concept's application. Ensure the code is well-commented to explain each step and its relevance. The explanation has to be as comments in the code*":[401,513],"#**Examples:**#*Provide practical code examples that illustrate the concept's application. Ensure the code is well-commented to explain each step and its relevance. The explanation has to be as comments in the code*#{1}":[403,513],"#**Flashcards:**":[514,530],"#**Flashcards:**#{1}":[516,530]},"outlinks":[{"title":"first, last)` that satisfies a given predicate. It returns an iterator to the first element for which the predicate returns `true`, or returns the `last` iterator if no such element is found.\n\n**Key characteristics:**\n- **Header**: `<algorithm>`\n- **Signature**: `template<class InputIt, class UnaryPredicate> InputIt find_if(InputIt first, InputIt last, UnaryPredicate p)`\n- **Complexity**: Linear in the distance between first and last - O(n)\n- **Iterator requirements**: InputIterator (read-only, forward movement)\n- **Return value**: Iterator to the first matching element, or `last` if not found\n- **Predicate**: Must be a unary function that returns a value convertible to `bool`\n\nThe algorithm works by iterating through the range and applying the predicate to each element until it finds one that satisfies the condition or reaches the end of the range.\n\n# **Related Concepts:**\n---\n\n- **`find()`**: Searches for an exact value match rather than using a predicate. `find_if()` is more flexible as it allows custom search criteria.\n- **`find_if_not()`**: Complementary algorithm that finds the first element that does NOT satisfy the predicate.\n- **`any_of()` / `all_of()` / `none_of()`**: Boolean algorithms that check conditions across ranges but return `bool` instead of iterators.\n- **Iterators**: `find_if()` operates on iterator ranges, making it container-agnostic and compatible with arrays, vectors, lists, etc.\n- **Predicates**: Functions, lambdas, or function objects that define the search criteria. Understanding predicates is essential for effective use of `find_if()`.\n- **`count_if()`**: Counts elements satisfying a predicate instead of finding the first occurrence.\n- **`search()` / `search_n()`**: More complex search algorithms for subsequences or patterns.\n\n# **Examples:**\n---\n## *Provide practical code examples that illustrate the concept's application. Ensure the code is well-commented to explain each step and its relevance. The explanation has to be as comments in the code*\n\n```cpp\n#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <string>\n\n// Example 1: Basic usage with lambda predicate\nvoid example_basic_lambda() {\n    std::vector<int> numbers = {1, 3, 5, 8, 12, 15, 20};\n    \n    // Find the first even number using a lambda predicate\n    auto it = std::find_if(numbers.begin(), numbers.end(), \n                          [","target":"int n","line":376}],"metadata":{"tags":["#will_learn"],"language":["C++"],"review-date":null,"last-reviewed":"","scheda":"done","confidence-level":0,"visit-count":1,"consecutive-correct":0,"last-struggle-date":"2025-07-05"},"task_lines":[],"last_embed":{"hash":"ju6k4a","at":1756458490121}},"smart_blocks:Computer Science/C++/C++ - find_if().md#**Purpose/Why**:#{1}": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.11575501,-0.01541917,-0.01137963,-0.04006978,0.04238758,-0.02979441,0.02067098,0.00684696,0.06645745,-0.05019712,0.02840617,-0.02262017,0.02749849,0.01750832,-0.01161601,0.00630793,-0.03374098,0.08390502,-0.03957962,-0.0430201,0.06717681,-0.02466097,-0.05425071,-0.10352703,0.04832714,0.05270607,0.00816843,-0.05905261,0.00468336,-0.23592645,-0.05930385,-0.01824773,0.05361522,-0.01017867,-0.01481061,-0.0061842,0.01622307,0.02370345,-0.0253882,0.06798569,0.04330632,0.00938443,0.0284936,0.0123154,-0.07432916,-0.01444266,-0.03674418,0.01981906,-0.02911182,-0.05678374,-0.01797001,0.02197036,0.03204365,-0.0001379,-0.03396712,0.07303663,0.08308513,0.04327161,0.01606191,0.01975645,0.0297958,-0.02601874,-0.12609266,0.03996988,0.01676716,0.01266701,0.01468711,-0.07965616,0.0339526,0.09331205,0.04793064,0.03419568,0.00386848,0.10053743,0.03050307,-0.00602758,0.02339874,-0.05964265,0.04513632,0.06102974,-0.01869701,-0.04770334,0.02232062,0.05864091,-0.03361193,-0.00248303,-0.02934126,-0.0