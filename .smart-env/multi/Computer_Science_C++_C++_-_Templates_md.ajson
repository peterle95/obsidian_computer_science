0.08368301,-0.02750434,0.00091178,0.04690057,0.19066377,-0.00026572,0.02491648,0.02195128,-0.00154873,0.00359824,0.12434103,0.04809887,-0.00616264,-0.04379867,0.11911186,0.06975595,-0.03644796,0.06541439,-0.0527599,0.01447133,0.02168808,-0.02110847,0.01582378,0.00786554,0.02871279,0.02376867,0.06622688,-0.0366363,0.0276091,-0.05701615,-0.03365078,-0.06778336,-0.02191363,0.01407356,0.00985665,0.01752199,0.00332054,0.09529363,0.00274634,-0.04043204,-0.0498175,-0.05000722,0.00297899,-0.03244487,0.08050127,0.04226689,0.02858158],"last_embed":{"hash":"dhuu2g","tokens":447}}},"last_read":{"hash":"dhuu2g","at":1762678885713},"class_name":"SmartSource","last_import":{"mtime":1762678760738,"size":24048,"at":1762678872045,"hash":"dhuu2g"},"blocks":{"#---frontmatter---":[1,16],"#":[17,426],"#**Purpose/Why**:":[427,436],"#**Purpose/Why**:#{1}":[429,433],"#**Purpose/Why**:#{2}":[434,434],"#**Purpose/Why**:#{3}":[435,436],"#FF5582A6;\">Templates are resolved at compile time</mark>, ensuring type safety without runtime overhead":[437,442],"#FF5582A6;\">Templates are resolved at compile time</mark>, ensuring type safety without runtime overhead#{1}":[438,438],"#FF5582A6;\">Templates are resolved at compile time</mark>, ensuring type safety without runtime overhead#{2}":[439,440],"#FF5582A6;\">Templates are resolved at compile time</mark>, ensuring type safety without runtime overhead#{3}":[441,442],"#**Core Explanation:**":[443,457],"#**Core Explanation:**#{1}":[445,448],"#**Core Explanation:**#{2}":[449,449],"#**Core Explanation:**#{3}":[450,450],"#**Core Explanation:**#{4}":[451,451],"#**Core Explanation:**#{5}":[452,452],"#**Core Explanation:**#{6}":[453,453],"#**Core Explanation:**#{7}":[454,455],"#**Core Explanation:**#{8}":[456,457],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.":[458,475],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{1}":[460,461],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{2}":[462,462],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{3}":[463,463],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{4}":[464,464],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{5}":[465,466],"#FFB8EBA6;\">Templates work through a process called template instantiation, where the compiler generates actual code by substituting template parameters with concrete types.</mark> This happens during compilation, not runtime, which means each unique combination of template arguments creates a separate copy of the code optimized for those specific types.#{6}":[467,475],"#**Related Concepts:**":[476,489],"#**Related Concepts:**#{1}":[478,478],"#**Related Concepts:**#{2}":[479,479],"#**Related Concepts:**#{3}":[480,480],"#**Related Concepts:**#{4}":[481,481],"#**Related Concepts:**#{5}":[482,482],"#**Related Concepts:**#{6}":[483,483],"#**Related Concepts:**#{7}":[484,484],"#**Related Concepts:**#{8}":[485,485],"#**Related Concepts:**#{9}":[486,486],"#**Related Concepts:**#{10}":[487,487],"#**Related Concepts:**#{11}":[488,489],"#**Examples:**":[490,766],"#**Examples:**#{1}":[492,766],"#**Flashcards:**":[767,780],"#**Flashcards:**#{1}":[769,780]},"outlinks":[{"title":"C++ - Template Argument Deduction","target":"C++ - Template Argument Deduction","line":454},{"title":"C++ - Templates vs Function Overloading","target":"C++ - Templates vs Function Overloading","line":479},{"title":"C++ - Template Metaprogramming","target":"C++ - Template Metaprogramming","line":482},{"title":"C++ - Concepts","target":"C++ - Concepts","line":484},{"title":"C++ - Template Header-Only Implementation","target":"C++ - Template Header-Only Implementation","line":488}],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["C++"],"review-date":null,"last-reviewed":"2025-08-20","scheda":"done","visit-count":4,"confidence-level":3,"consecutive-correct":4,"last-struggle-date":"","cssclasses":null},"last_embed":{"hash":"dhuu2g","at":1762678885678},"key":"Computer Science/C++/C++ - Templates.md","task_lines":[]},
