452,452],"#This is where the application code will live.":[453,455],"#This is where the application code will live.#{1}":[454,455],"#--- Copy Application Files ---":[456,456],"#Copy the package.json and package-lock.json files to the working directory.":[457,457],"#This is done separately to leverage Docker's layer caching.":[458,458],"#The dependencies will only be re-installed if these files change.":[459,461],"#The dependencies will only be re-installed if these files change.#{1}":[460,461],"#--- Install Dependencies ---":[462,462],"#Run the 'npm install' command to install the application's dependencies.":[463,465],"#Run the 'npm install' command to install the application's dependencies.#{1}":[464,465],"#--- Copy Source Code ---":[466,466],"#Copy the rest of the application's source code into the container.":[467,469],"#Copy the rest of the application's source code into the container.#{1}":[468,469],"#--- Expose Port ---":[470,470],"#Inform Docker that the container will listen on port 8080 at runtime.":[471,473],"#Inform Docker that the container will listen on port 8080 at runtime.#{1}":[472,473],"#--- Define Startup Command ---":[474,474],"#Specify the command to run when the container starts.":[475,475],"#This will start the Node.js application.":[476,480],"#This will start the Node.js application.#{1}":[477,480],"#Command to build the Docker image from the Dockerfile.":[481,481],"#The '-t' flag tags the image with a name (e.g., 'my-node-app').":[482,482],"#The '.' indicates that the Dockerfile is in the current directory.":[483,485],"#The '.' indicates that the Dockerfile is in the current directory.#{1}":[484,485],"#Command to run the Docker container from the newly created image.":[486,486],"#The '-p' flag maps port 8080 on the host to port 8080 in the container.":[487,487],"#The '-d' flag runs the container in detached mode (in the background).":[488,506],"#The '-d' flag runs the container in detached mode (in the background).#{1}":[489,506]},"outlinks":[],"metadata":{"tags":null,"language":null,"review-date":null,"last-reviewed":"","scheda":"to_finish","visit-count":0,"confidence-level":1,"consecutive-correct":0,"last-struggle-date":"","cssclasses":null},"task_lines":[],"last_embed":{"hash":"7vm4o5","at":1757401144313}},"smart_blocks:Assets/Put_here_hyperlinknote/Docker - What are Docker Containers.md#**Purpose/Why**:": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02600993,-0.06411032,0.00825233,-0.07168029,0.04293177,-0.05921387,-0.02278559,-0.02682367,-0.03363978,-0.02918459,0.00802834,0.00443649,0.08927146,0.01867383,-0.02167775,0.01366481,-0.02500006,0.02437038,-0.00447184,-0.02027119,0.03131849,-0.03874265,-0.02822298,-0.11984445,-0.01533541,0.07806621,-0.03216291,-0.02948033,-0.02049984,-0.2015672,0.00097898,0.02416199,-0.01742137,0.0119692,0.03605895,0.01921233,0.03795548,0.03865673,-0.02237741,0.00360534,0.03345116,0.06401832,0.00330705,0.03866566,-0.00182689,-0.01899387,-0.06110722,0.00211531,0.00878216,-0.02637257,0.00082051,-0.02578762,-0.03615152,-0.01630908,-0.00480068,0.0833317,0.09767205,0.04036607,0.00368109,0.00345857,0.04505523,-0.01474955,-0.13502266,0.10628864,0.153382,0.00106525,-0.01993847,-0.02337845,0.04218722,0.01109054,-0.06523639,0.03706367,0.00394908,0.10738334,0.03451992,0.01534177,0.00810154,0.03787377,-0.0029024,0.01702992,0.03419123,-0.04110344,0.02299737,0.03910821,-0.1012077,-0.01024066,-0.00906058,-0.01413487,0.05166148,-0.02749377,-0.07776304,-0.00777631,0.0639021,0.00365101,0.01361801,0.00299963,0.01723206,0.00327282,-0.11645122,0.11246703,-0.02916532,0.00318436,-0.03374927,-0.04049348,0.0514662,0.01034994,-0.00657986,-0.03354013,-0.01597633,0.03126216,0.00215392,-0.00261594,0.00340036,-0.02911661,-0.04495544,-0.03816979,-0.0683811,0.02317953,0.01683405,-0.05310256,-0.01014559,0.03880752,0.08343333,0.0202706,0.03116278,-0.02302232,0.00237247,-0.03509428,-0.03347404,0.01126429,0.00641224,0.00941593,-0.00709712,-0.0167205,0.05882279,0.01956767,-0.00964075,-0.06