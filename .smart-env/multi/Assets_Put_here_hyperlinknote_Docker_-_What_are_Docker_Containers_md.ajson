1],"#This is where the application code will live.#{1}":[100,101],"#--- Copy Application Files ---":[102,102],"#Copy the package.json and package-lock.json files to the working directory.":[103,103],"#This is done separately to leverage Docker's layer caching.":[104,104],"#The dependencies will only be re-installed if these files change.":[105,107],"#The dependencies will only be re-installed if these files change.#{1}":[106,107],"#--- Install Dependencies ---":[108,108],"#Run the 'npm install' command to install the application's dependencies.":[109,111],"#Run the 'npm install' command to install the application's dependencies.#{1}":[110,111],"#--- Copy Source Code ---":[112,112],"#Copy the rest of the application's source code into the container.":[113,115],"#Copy the rest of the application's source code into the container.#{1}":[114,115],"#--- Expose Port ---":[116,116],"#Inform Docker that the container will listen on port 8080 at runtime.":[117,119],"#Inform Docker that the container will listen on port 8080 at runtime.#{1}":[118,119],"#--- Define Startup Command ---":[120,120],"#Specify the command to run when the container starts.":[121,121],"#This will start the Node.js application.":[122,126],"#This will start the Node.js application.#{1}":[123,126],"#Command to build the Docker image from the Dockerfile.":[127,127],"#The '-t' flag tags the image with a name (e.g., 'my-node-app').":[128,128],"#The '.' indicates that the Dockerfile is in the current directory.":[129,131],"#The '.' indicates that the Dockerfile is in the current directory.#{1}":[130,131],"#Command to run the Docker container from the newly created image.":[132,132],"#The '-p' flag maps port 8080 on the host to port 8080 in the container.":[133,133],"#The '-d' flag runs the container in detached mode (in the background).":[134,152],"#The '-d' flag runs the container in detached mode (in the background).#{1}":[135,152]},"outlinks":[],"metadata":{"tags":null,"language":null,"review-date":null,"