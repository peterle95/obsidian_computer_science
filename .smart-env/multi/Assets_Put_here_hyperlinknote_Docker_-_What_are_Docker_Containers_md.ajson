s is where the application code will live.#{1}":[100,101],"#--- Copy Application Files ---":[102,102],"#Copy the package.json and package-lock.json files to the working directory.":[103,103],"#This is done separately to leverage Docker's layer caching.":[104,104],"#The dependencies will only be re-installed if these files change.":[105,107],"#The dependencies will only be re-installed if these files change.#{1}":[106,107],"#--- Install Dependencies ---":[108,108],"#Run the 'npm install' command to install the application's dependencies.":[109,111],"#Run the 'npm install' command to install the application's dependencies.#{1}":[110,111],"#--- Copy Source Code ---":[112,112],"#Copy the rest of the application's source code into the container.":[113,115],"#Copy the rest of the application's source code into the container.#{1}":[114,115],"#--- Expose Port ---":[116,116],"#Inform Docker that the container will listen on port 8080 at runtime.":[117,119],"#Inform Docker that the container will listen on port 8080 at runtime.#{1}":[118,119],"#--- Define Startup Command ---":[120,120],"#Specify the command to run when the container starts.":[121,121],"#This will start the Node.js application.":[122,126],"#This will start the Node.js application.#{1}":[123,126],"#Command to build the Docker image from the Dockerfile.":[127,127],"#The '-t' flag tags the image with a name (e.g., 'my-node-app').":[128,128],"#The '.' indicates that the Dockerfile is in the current directory.":[129,131],"#The '.' indicates that the Dockerfile is in the current directory.#{1}":[130,131],"#Command to run the Docker container from the newly created image.":[132,132],"#The '-p' flag maps port 8080 on the host to port 8080 in the container.":[133,133],"#The '-d' flag runs the container in detached mode (in the background).":[134,147],"#The '-d' flag runs the container in detached mode (in the background).#{1}":[135,147]},"outlinks":[],"metadata":{"tags":null,"language":null,"review-date":null,"last-reviewed":"","scheda":"to_finish","visit-count":0,"confidence-level":1,"consecutive-correct":0,"last-struggle-date":"","cssclasses":null},"task_lines":[],"last_embed":{"hash":"eqh2l","at":1757400929030}},"smart_blocks:Assets/Put_here_hyperlinknote/Docker - What are Docker Containers.md#**Purpose/Why**:": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.02962634,-0.06690481,0.00838871,-0.071775,0.04348958,-0.05654287,-0.02897963,-0.02944071,-0.03499318,-0.02801738,0.01169167,0.00584332,0.08899994,0.01617921,-0.01924715,0.01761747,-0.02944462,0.01654617,-0.00563564,-0.02397347,0.02783973,-0.0403717,-0.02683624,-0.112518,-0.01485434,0.07596654,-0.03249703,-0.02826497,-0.02142961,-0.20220983,-0.00196333,0.02087668,-0.02089743,0.01781698,0.03558553,0.01762514,0.03895866,0.03736035,-0.02468299,-0.00179642,0.03558684,0.06161983,0.0035521,0.0324742,0.00157908,-0.01366193,-0.05777447,0.0049761,0.004986,-0.02747289,0.00438086,-0.03143114,-0.03209377,-0.01579119,-0.00202019,0.08612515,0.09404168,0.04481017,0.00007922,0.00055145,0.0445013,-0.01260227,-0.13891129,0.10875336,0.1548277,-0.00060114,-0.02125717,-0.03296428,0.04135198,0.01416622,-0.06662501,0.0352159,0.00206068,0.10677446,0.03767803,0.01208576,0.0097824,0.04499137,-0.0054902,0.01228942,0.03980165,-0.04109689,0.0209096,0.04779553,-0.09810958,-0.00637122,-0.01116554,-0.01051545,0.04679448,-0.03033947,-0.07128812,-0.00065546,0.06209379,0.00360533,0.01579153,0.00754641,0.01777134,0.00068553,-0.11885019,0.10414749,-0.02630965,0.00314619,-0.03766531,-0.03203072,0.04830563,0.0122645,-0.00317597,-0.03421498,-0.01641037,0.03227912,0.00209978,-0.00108055,0.00312441,-0.02909317,-0.04755439,-0.03387641,-0.06659959,0.02432329,0.01218121,-0.0568,-0.00717464,0.03565937,0.08671545,0.01759909,0.03135585,-0.02658339,-0.00009247,-0.03741694,-0.03037114,0.00966936,0.01012939,0.00622932,-0.01053892,-0.01541094,0.05570237,0.02010889,-0.00599082,-0.0597888,-0.01200018,0.08234577,-0.06146092,0.03456005,0.06736062,-0.09137089,-0.01