7918,0.05730043,0.01982354,-0.07058728,-0.0569843,-0.00662214,0.02474189,-0.02369636,0.10822925,-0.04834656,0.01137489,0.05538872,0.20932899,0.03908079,0.02548253,0.04706825,-0.03582142,0.01754213,0.11132865,0.04480181,0.00226228,-0.03409705,0.13385275,0.06349448,-0.02508553,0.00515813,-0.05892935,-0.02944664,0.0343061,-0.01740018,0.01855773,-0.00040826,0.05781943,0.01957442,0.09553504,-0.02698294,0.00778421,-0.05611386,-0.01826276,-0.05636367,-0.0267493,-0.00913406,0.004622,-0.02305394,0.00882947,0.07251724,0.00067263,-0.01519891,-0.06219126,-0.04282692,-0.01199674,-0.02004746,0.04314879,0.03859083,0.02707573],"last_embed":{"hash":"7e4ind","tokens":469}}},"last_read":{"hash":"7e4ind","at":1757838198063},"class_name":"SmartSource","last_import":{"mtime":1757838186311,"size":37058,"at":1757838197775,"hash":"7e4ind"},"blocks":{"#---frontmatter---":[1,14],"#":[16,369],"#**Purpose/Why**:":[370,382],"#**Purpose/Why**:#{1}":[371,376],"#**Purpose/Why**:#{2}":[377,378],"#**Purpose/Why**:#{3}":[379,380],"#**Purpose/Why**:#{4}":[381,382],"#**Core Explanation:**":[383,400],"#**Core Explanation:**#{1}":[385,387],"#**Core Explanation:**#{2}":[388,389],"#**Core Explanation:**#{3}":[390,392],"#**Core Explanation:**#{4}":[393,400],"#Array destructuring":[401,562],"#Array destructuring#{1}":[403,562],"#The rest ‘…’ Usually, if the array is longer than the list at the left, the “extra” items are omitted. For example, here only two items are taken, and the rest is just ignored: ```javascript let [name1, name2] = [\"Julius\", \"Caesar\", \"Consul\", \"of the Roman Republic\"]; alert(name1); // Julius alert(name2); // Caesar // Further items aren't assigned anywhere``":[563,600],"#The rest ‘…’ Usually, if the array is longer than the list at the left, the “extra” items are omitted. For example, here only two items are taken, and the rest is just ignored: ```javascript let [name1, name2] = [\"Julius\", \"Caesar\", \"Consul\", \"of the Roman Republic\"]; alert(name1); // Julius alert(name2); // Caesar // Further items aren't assigned anywhere``#{1}":[566,600],"#Default values":[601,650],"#Default values#{1}":[603,650],"#Object destructuring The destructuring assignment also works with objects. The basic syntax is: ```javascript let {var1, var2} = {var1:…, var2:…}``":[651,771],"#Object destructuring The destructuring assignment also works with objects. The basic syntax is: ```javascript let {var1, var2} = {var1:…, var2:…}``#{1}":[654,771],"#The rest pattern “…” What if the object has more properties than we have variables? Can we take some and then assign the “rest” somewhere? We can use the rest pattern, just like we did with arrays. It’s not supported by some older browsers (IE, use Babel to polyfill it), but works in modern ones. It looks like this: ```javascript let options = { title: \"Menu\", height: 200, width: 100 }; // title = property named title // rest = object with the rest of properties let {title, ...rest} = options; // now title=\"Menu\", rest={height: 200, width: 100} alert(rest.height); // 200 alert(rest.width); // 100`":[772,826],"#The rest pattern “…” What if the object has more properties than we have variables? Can we take some and then assign the “rest” somewhere? We can use the rest pattern, just like we did with arrays. It’s not supported by some older browsers (IE, use Babel to polyfill it), but works in modern ones. It looks like this: ```javascript let options = { title: \"Menu\", height: 200, width: 100 }; // title = property named title // rest = object with the rest of properties let {title, ...rest} = options; // now title=\"Menu\", rest={height: 200, width: 100} alert(rest.height); // 200 alert(rest.width); // 100`#{1}":[775,826],"#Nested destructuring":[827,834],"#Nested destructuring#{1}":[829,834],"#\"run\")":[835,857],"#\"run\")#{1}":[837,857],"#Smart function parameters":[858,978],"#Smart function parameters#{1}":[860,978],"#Summary":[979,1020],"#Summary#{1}":[981,982],"#Summary#{2}":[983,984],"#Summary#{3}":[985,1001],"#Summary#{4}":[1002,1003],"#Summary#{5}":[1004,1018],"#Summary#{6}":[1019,1020],"#**Related Concepts:**":[1021,1025],"#**Related Concepts:**#{1}":[1023,1025],"#Identify and briefly explain any concepts that are closely related, dependent on, or analogous to the current topic. How do they connect or differ?":[1026,1037],"#Identify and briefly explain any concepts that are closely related, dependent on, or analogous to the current topic. How do they connect or differ?#{1}":[1028,1029],"#Identify and briefly explain any concepts that are closely related, dependent on, or analogous to the current topic. How do they connect or differ?#{2}":[1030,1031],"#Identify and briefly explain any concepts that are closely related, dependent on, or analogous to the current topic. How do they connect or differ?#{3}":[1032,1033],"#Identify and briefly explain any concepts that are closely related, dependent on, or analogous to the current topic. How do they connect or differ?#{4}":[1034,1037],"#**Examples:**":[1038,1041],"#**Examples:**#{1}":[1040,1041],"#Provide practical code examples that illustrate the concept's application. Ensure the code is well-commented to explain each step and its relevance. The explanation has to be as comments in the code":[1042,1081],"#Provide practical code examples that illustrate the concept's application. Ensure the code is well-commented to explain each step and its relevance. The explanation has to be as comments in the code#{1}":[1044,1081],"#**Flashcards:**":[1082,1118],"#**Flashcards:**#{1}":[1084,1093],"#**Flashcards:**#{2}":[1094,1094],"#**Flashcards:**#{3}":[1095,1095],"#**Flashcards:**#{4}":[1096,1096],"#**Flashcards:**#{5}":[1097,1097],"#**Flashcards:**#{6}":[1098,1098],"#**Flashcards:**#{7}":[1099,1099],"#**Flashcards:**#{8}":[1100,1100],"#**Flashcards:**#{9}":[1101,1101],"#**Flashcards:**#{10}":[1102,1102],"#**Flashcards:**#{11}":[1103,1103],"#**Flashcards:**#{12}":[1104,1104],"#**Flashcards:**#{13}":[1105,1105],"#**Flashcards:**#{