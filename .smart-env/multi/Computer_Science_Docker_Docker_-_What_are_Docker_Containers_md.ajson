here the application code will live.":[456,458],"#This is where the application code will live.#{1}":[457,458],"#--- Copy Application Files ---":[459,459],"#Copy the package.json and package-lock.json files to the working directory.":[460,460],"#This is done separately to leverage Docker's layer caching.":[461,461],"#The dependencies will only be re-installed if these files change.":[462,464],"#The dependencies will only be re-installed if these files change.#{1}":[463,464],"#--- Install Dependencies ---":[465,465],"#Run the 'npm install' command to install the application's dependencies.":[466,468],"#Run the 'npm install' command to install the application's dependencies.#{1}":[467,468],"#--- Copy Source Code ---":[469,469],"#Copy the rest of the application's source code into the container.":[470,472],"#Copy the rest of the application's source code into the container.#{1}":[471,472],"#--- Expose Port ---":[473,473],"#Inform Docker that the container will listen on port 8080 at runtime.":[474,476],"#Inform Docker that the container will listen on port 8080 at runtime.#{1}":[475,476],"#--- Define Startup Command ---":[477,477],"#Specify the command to run when the container starts.":[478,478],"#This will start the Node.js application.":[479,483],"#This will start the Node.js application.#{1}":[480,483],"#Command to build the Docker image from the Dockerfile.":[484,484],"#The '-t' flag tags the image with a name (e.g., 'my-node-app').":[485,485],"#The '.' indicates that the Dockerfile is in the current directory.":[486,488],"#The '.' indicates that the Dockerfile is in the current directory.#{1}":[487,488],"#Command to run the Docker container from the newly created image.":[489,489],"#The '-p' flag maps port 8080 on the host to port 8080 in the container.":[490,490],"#The '-d' flag runs the container in detached mode (in the background).":[491,509],"#The '-d' flag runs the container in detached mode (in the background).#{1}":[492,509]},"outlinks":[{"title":"Node.js - Server-Side JavaScript","target":"Node.js - Server-Side JavaScript","line":417}],"metadata":{"memory":"to_finish","tags":["#learning"],"language":["Docker"],"review-date":"2025-11-15","last-reviewed":"2025-10-16","scheda":"done","visit-count":2,"confidence-level":2,"consecutive-correct":2,"last-struggle-date":"","cssclasses":null},"task_lines":[],"last_embed":{"hash":"1ejg1zf","at":1762678879257},"key":"Computer Science/Docker/Docker - What are Docker Containers.md"},
