3703668,0.0119621,0.06806932,0.19622453,0.00793341,0.0417868,0.02833331,0.00683961,0.00790424,0.08320039,0.02038832,-0.01830921,-0.04284763,0.13927656,0.03958089,-0.0333951,0.0557353,-0.06419323,0.00596402,0.020364,-0.01742254,0.01254593,0.0080128,0.03923556,0.03207139,0.07525139,-0.02047894,0.00927687,-0.05330882,-0.0140474,-0.03153496,-0.01963766,0.01395464,0.03396534,0.01101146,-0.01119774,0.09939806,-0.00108144,-0.01450475,-0.0516302,-0.06745381,-0.00986352,-0.06906406,0.06617308,0.02187092,0.03521756],"last_embed":{"hash":"1s9u559","tokens":452}}},"last_read":{"hash":"1s9u559","at":1757488943614},"class_name":"SmartSource","last_import":{"mtime":1757488929174,"size":24273,"at":1757488942442,"hash":"1s9u559"},"blocks":{"#---frontmatter---":[1,14],"#":[15,424],"#**Purpose/Why**:":[425,429],"#**Purpose/Why**:#{1}":[427,429],"#**Core Explanation:**":[430,435],"#**Core Explanation:**#{1}":[432,435],"#ABF7F7A6;\">Unlike upcasting (derived to base), which is always safe and implicit, downcasting is potentially dangerous because the base class pointer might not actually point to an object of the target derived type.</mark>":[436,441],"#ABF7F7A6;\">Unlike upcasting (derived to base), which is always safe and implicit, downcasting is potentially dangerous because the base class pointer might not actually point to an object of the target derived type.</mark>#{1}":[438,441],"#FF5582A6;\">It uses Runtime Type Information (RTTI) to verify that the cast is valid.</mark> If the cast fails, it returns nullptr for pointers or throws std::bad_cast for references. This only works with polymorphic classes (classes with at least one virtual function).":[442,449],"#FF5582A6;\">It uses Runtime Type Information (RTTI) to verify that the cast is valid.</mark> If the cast fails, it returns nullptr for pointers or throws std::bad_cast for references. This only works with polymorphic classes (classes with at least one virtual function).#{1}":[444,449],"#**Related Concepts:**":[450,466],"#**Related Concepts:**#{1}":[452,466],"#**Examples:**":[467,836],"#**Examples:**#{1}":[469,836],"#**Flashcards:**":[837,844],"#**Flashcards:**#{1}":[839,844]},"outlinks":[{"title":"C++ Runtime Type Identification (RTTI)","target":"C++ Runtime Type Identification (RTTI)","line":459},{"title":"C++ Smart Pointers","target":"C++ Smart Pointers","line":465}],"metadata":{"tags":["#learned"],"language":["C++"],"review-date":"","last-reviewed":"2025-07-13","scheda":"done","visit-count":2,"confidence-level":1,"consecutive-correct":1,"last-struggle-date":"2025-07-10"},"last_embed":{"hash":"1s9u559","at":1757488943533},"key":"Computer Science/C++/C++ Downcasting.md","task_lines":[]},
