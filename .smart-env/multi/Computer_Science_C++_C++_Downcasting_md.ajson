2,0.00145818,0.06049293,0.18785305,0.00598758,0.04593239,0.02653518,0.00077332,0.01698793,0.09563051,0.02818194,-0.01660362,-0.03785301,0.13309474,0.04552781,-0.03632769,0.05974293,-0.06110371,0.00633151,0.0226208,-0.01141309,0.02363622,0.00549171,0.03807477,0.03181845,0.08023701,-0.01728744,0.00699453,-0.0568902,-0.01918988,-0.03690442,-0.01352901,0.01458926,0.03547736,0.00567926,-0.00684897,0.0981791,-0.00233338,-0.01863757,-0.04622535,-0.05061155,-0.00392797,-0.05990359,0.07035607,0.0248981,0.03584022],"last_embed":{"hash":"1tgb6l","tokens":448}}},"last_read":{"hash":"1tgb6l","at":1762678885276},"class_name":"SmartSource","last_import":{"mtime":1762678760318,"size":24291,"at":1762678872024,"hash":"1tgb6l"},"blocks":{"#---frontmatter---":[1,15],"#":[16,425],"#**Purpose/Why**:":[426,430],"#**Purpose/Why**:#{1}":[428,430],"#**Core Explanation:**":[431,436],"#**Core Explanation:**#{1}":[433,436],"#ABF7F7A6;\">Unlike upcasting (derived to base), which is always safe and implicit, downcasting is potentially dangerous because the base class pointer might not actually point to an object of the target derived type.</mark>":[437,442],"#ABF7F7A6;\">Unlike upcasting (derived to base), which is always safe and implicit, downcasting is potentially dangerous because the base class pointer might not actually point to an object of the target derived type.</mark>#{1}":[439,442],"#FF5582A6;\">It uses Runtime Type Information (RTTI) to verify that the cast is valid.</mark> If the cast fails, it returns nullptr for pointers or throws std::bad_cast for references. This only works with polymorphic classes (classes with at least one virtual function).":[443,450],"#FF5582A6;\">It uses Runtime Type Information (RTTI) to verify that the cast is valid.</mark> If the cast fails, it returns nullptr for pointers or throws std::bad_cast for references. This only works with polymorphic classes (classes with at least one virtual function).#{1}":[445,450],"#**Related Concepts:**":[451,467],"#**Related Concepts:**#{1}":[453,467],"#**Examples:**":[468,837],"#**Examples:**#{1}":[470,837],"#**Flashcards:**":[838,845],"#**Flashcards:**#{1}":[840,845]},"outlinks":[{"title":"C++ Runtime Type Identification (RTTI)","target":"C++ Runtime Type Identification (RTTI)","line":460},{"title":"C++ Smart Pointers","target":"C++ Smart Pointers","line":466}],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["C++"],"review-date":"","last-reviewed":"2025-07-13","scheda":"done","visit-count":2,"confidence-level":1,"consecutive-correct":1,"last-struggle-date":"2025-07-10"},"last_embed":{"hash":"1tgb6l","at":1762678885244},"key":"Computer Science/C++/C++ Downcasting.md","task_lines":[]},"smart_blocks:Computer Science/C++/C++ Downcasting.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08914272,-0.02921835,0.01770367,-0.01115653,-0.06606632,0.03599181,-0.06344856,0.04761895,0.03574163,0.0110887,-0.00793294,-0.03279655,0.02431977,0.03575341,-0.01559417,-0.00427145,-0.04488434,0.03283448,0.0172135,-0.02776028,0.03637983,-0.04328741,0.01554006,-0.03729535,0.00595342,0.01091613,-0.04397399,-0.14245914,-0.04989469,-0.20066994,-0.07596174,-0.02251523,0.02857591,0.00799854,0.00862636,-0.05106924,-0.00477622,0.00878884,-0.01526613,0.05454101,0.04198666,0.04231177,-0.0134735,-0.04858306,0.01907883,-0.01427677,0.0209097,-0.01573653,0.00857844,0.01928509,-0.02130744,-0.01709046,0.02260265,0.0259972,0.00836158,0.05707174,0.07334661,0.05534414,0.0478291,-0.00880266,0.04447932,-0.0138001,-0.22278063,0.07269446,-0.00959121,0.0360552,-0.03063285,-0.00534092,-0.01289106,0.08690121,0.02683633,-0.03773949,-0.01184279,0.07598478,0.02041543,-0.01678965,0.01242086,-0.0361311,-0.00152934,-0.04302365,0.02087805,-0.01457832,-0.00318961,-0.02345193,-0.00084375,-0.04549029,-0.03916192,0.02912987,0.01821265,0.00440036,0.03646725,-0.01848182,0.03809787,0.08999563,-0.0705756,-0.04281589,0.10001364,0.03206166,-0.07600618,0.09709108,-0.09435284,0.02843601,-0.03414