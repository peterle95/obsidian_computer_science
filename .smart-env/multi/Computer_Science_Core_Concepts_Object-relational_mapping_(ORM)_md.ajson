ncepts:**#{9}":[450,450],"#**Related Concepts:**#{10}":[451,451],"#**Related Concepts:**#{11}":[452,452],"#**Related Concepts:**#{12}":[453,454],"#**Examples:**":[455,460],"#**Examples:**#{1}":[457,460],"#, or Python, there are several ORM frameworks available for C++.":[461,754],"#, or Python, there are several ORM frameworks available for C++.#{1}":[463,554],"#, or Python, there are several ORM frameworks available for C++.#{2}":[555,555],"#, or Python, there are several ORM frameworks available for C++.#{3}":[556,556],"#, or Python, there are several ORM frameworks available for C++.#{4}":[557,557],"#, or Python, there are several ORM frameworks available for C++.#{5}":[558,558],"#, or Python, there are several ORM frameworks available for C++.#{6}":[559,754],"#, or Python, there are several ORM frameworks available for C++.#{7}":[561,754],"#**Flashcards:**":[755,762],"#**Flashcards:**#{1}":[757,762]},"outlinks":[{"title":"Relational database","target":"Relational database","line":429},{"title":"Tuple","target":"Tuple","line":433},{"title":"SQL queries","target":"SQL queries","line":437}],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["Core Concepts"],"review-date":"","last-reviewed":"2025-08-11","scheda":"done","visit-count":3,"confidence-level":2,"consecutive-correct":2,"last-struggle-date":"2025-07-07"},"last_embed":{"hash":"1i45otm","at":1762678880711},"key":"Computer Science/Core Concepts/Object-relational mapping (ORM).md","task_lines":[]},
