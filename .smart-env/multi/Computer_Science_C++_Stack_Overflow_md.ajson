,-0.03230178,0.00502868,0.04036538,0.19254333,0.01312018,0.01199882,0.03057563,-0.01496759,-0.00183082,0.12418179,0.04327658,-0.00115659,-0.0395069,0.11786988,0.06284738,-0.02811916,0.05007575,-0.05626407,0.00745546,0.03703555,-0.02897592,0.03093834,-0.00060207,0.0354695,0.02885702,0.07646184,-0.03367421,0.04065201,-0.06638085,-0.03358918,-0.05934466,-0.03079932,-0.0042795,0.01165916,0.00667148,0.0111269,0.09148639,0.00769722,-0.01746075,-0.05903943,-0.05326403,0.00501553,-0.03146636,0.09040478,0.04648495,0.02689786],"last_embed":{"hash":"1axla5u","tokens":448}}},"last_read":{"hash":"1axla5u","at":1762678882305},"class_name":"SmartSource","last_import":{"mtime":1762678757793,"size":29589,"at":1762678871910,"hash":"1axla5u"},"blocks":{"#---frontmatter---":[1,15],"#":[16,425],"#**Purpose/Why**:":[426,430],"#**Purpose/Why**:#{1}":[428,430],"#**Core Explanation:**":[431,435],"#**Core Explanation:**#{1}":[433,435],"#FF5582A6;\">Stack overflow is a runtime error that occurs when a program's call stack exceeds its allocated memory limit</mark>. The call stack is a region of memory used to store information about active function calls, including local variables, function parameters, return addresses, and execution context.":[436,441],"#FF5582A6;\">Stack overflow is a runtime error that occurs when a program's call stack exceeds its allocated memory limit</mark>. The call stack is a region of memory used to store information about active function calls, including local variables, function parameters, return addresses, and execution context.#{1}":[438,441],"#BBFABBA6;\">most common cause is infinite or deeply nested recursion where functions call themselves or each other without proper termination conditions</mark>. Other causes include allocating very large local variables or arrays on the stack, or having extremely deep function call chains.":[442,453],"#BBFABBA6;\">most common cause is infinite or deeply nested recursion where functions call themselves or each other without proper termination conditions</mark>. Other causes include allocating very large local variables or arrays on the stack, or having extremely deep function call chains.#{1}":[444,453],"#**Related Concepts:**":[454,472],"#**Related Concepts:**#{1}":[456,472],"#**Examples:**":[473,987],"#**Examples:**#{1}":[475,987],"#**Flashcards:**":[988,994],"#**Flashcards:**#{1}":[990,994],"#(StackOverflowException), and others. Languages differ in detection mechanisms and stack size limits, but all use stack-based memory for function calls and local variables.":[995,997],"#(StackOverflowException), and others. Languages differ in detection mechanisms and stack size limits, but all use stack-based memory for function calls and local variables.#{1}":[997,997]},"outlinks":[],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["Core Concepts"],"review-date":"","last-reviewed":"2025-08-15","scheda":"done","visit-count":2,"confidence-level":1,"consecutive-correct":1,"last-struggle-date":"2025-08-05"},"last_embed":{"hash":"1axla5u","at":1762678882274},"key":"Computer Science/C++/Stack Overflow.md","task_lines":[]},
