 you.#{1}":[450,471],"#Pointers and References":[472,493],"#Pointers and References#{1}":[474,476],"#Pointers and References#{2}":[477,477],"#Pointers and References#{3}":[478,493],"#Pointers and References#{4}":[480,493],"#Differences":[494,591],"#Differences#{1}":[496,499],"#Differences#{2}":[500,503],"#Differences#{3}":[504,507],"#Differences#{4}":[508,511],"#Differences#{5}":[512,515],"#Differences#{6}":[516,519],"#Differences#{7}":[520,584],"#Differences#{8}":[585,585],"#Differences#{9}":[586,591],"#When to Use Pointers vs References":[592,597],"#When to Use Pointers vs References#{1}":[594,597],"#Use References":[598,604],"#Use References#{1}":[599,599],"#Use References#{2}":[600,600],"#Use References#{3}":[601,602],"#Use References#{4}":[603,604],"#Use Pointers":[605,614],"#Use Pointers#{1}":[606,606],"#Use Pointers#{2}":[607,607],"#Use Pointers#{3}":[608,608],"#Use Pointers#{4}":[609,610],"#Use Pointers#{5}":[611,614],"#Flashcards":[615,628],"#Flashcards#{1}":[617,628]},"outlinks":[{"title":"Distinguishing Between Pointers, Dereferenced Pointers, and References","target":"Distinguishing Between Pointers, Dereferenced Pointers, and References","line":430}],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["C++"],"review-date":"","last-reviewed":"2025-08-06","scheda":"done","visit-count":3,"confidence-level":2,"consecutive-correct":2,"last-struggle-date":"2025-07-06"},"last_embed":{"hash":"9wplht","at":1762678884512},"key":"Computer Science/C++/C++ Pointers and References use-cases.md","task_lines":[]},
