0.01231207,0.08670764,-0.03397822,0.01710622,0.04191025,0.19104315,0.00795951,0.01017925,0.03889257,-0.01891115,0.00297632,0.13491008,0.03932434,0.01187856,-0.03912846,0.10949383,0.05073832,-0.02292774,0.05110063,-0.0554318,0.0132152,0.03807874,-0.01891644,0.02651201,-0.01742652,0.0399793,0.01145945,0.08178692,-0.03492447,0.03688709,-0.0876471,-0.04710031,-0.04619826,-0.04712643,-0.01568764,0.03372943,0.01108463,0.03647955,0.10013136,0.00606938,-0.01864454,-0.06733926,-0.04751683,0.02119171,-0.02070386,0.09489901,0.05204778,0.01348933],"last_embed":{"hash":"1bh660x","tokens":448}}},"last_read":{"hash":"1bh660x","at":1762678880604},"class_name":"SmartSource","last_import":{"mtime":1762678756922,"size":20491,"at":1762678871851,"hash":"1bh660x"},"blocks":{"#---frontmatter---":[1,15],"#":[16,425],"#**Purpose/Why**:":[426,430],"#**Purpose/Why**:#{1}":[428,430],"#**Core Explanation:**":[431,445],"#**Core Explanation:**#{1}":[433,437],"#**Core Explanation:**#{2}":[438,438],"#**Core Explanation:**#{3}":[439,439],"#**Core Explanation:**#{4}":[440,440],"#**Core Explanation:**#{5}":[441,441],"#**Core Explanation:**#{6}":[442,443],"#**Core Explanation:**#{7}":[444,445],"#FF5582A6;\">Processes are managed by the operating system's process scheduler, which determines which process gets CPU time and when</mark>. The OS maintains process isolation through memory protection mechanisms, ensuring processes cannot access each other's memory directly. Inter-Process Communication (IPC) mechanisms like pipes, shared memory, and message queues allow controlled communication between processes when needed.":[446,449],"#FF5582A6;\">Processes are managed by the operating system's process scheduler, which determines which process gets CPU time and when</mark>. The OS maintains process isolation through memory protection mechanisms, ensuring processes cannot access each other's memory directly. Inter-Process Communication (IPC) mechanisms like pipes, shared memory, and message queues allow controlled communication between processes when needed.#{1}":[448,449],"#**Related Concepts:**":[450,466],"#**Related Concepts:**#{1}":[452,466],"#**Examples:**":[467,690],"#**Examples:**#{1}":[469,690],"#**Flashcards:**":[691,698],"#**Flashcards:**#{1}":[693,698]},"outlinks":[],"metadata":{"memory":"to_finish","tags":["#learned"],"language":["Core Concepts"],"review-date":null,"last-reviewed":"2025-08-20","scheda":"done","visit-count":2,"confidence-level":1,"consecutive-correct":1,"last-struggle-date":"2025-08-10"},"last_embed":{"hash":"1bh660x","at":1762678880562},"key":"Computer Science/Core Concepts/processes.md","task_lines":[]},
